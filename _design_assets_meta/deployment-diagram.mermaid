flowchart TD
    subgraph "Client"
        Browser[User Browser]
    end
    
    subgraph "Vercel Platform"
        subgraph "NextJS App"
            NextFrontend[Next.js Frontend]
            APIRoutes[API Routes]
            EdgeFunctions[Edge Functions]
        end
    end
    
    subgraph "Database Services"
        subgraph "Supabase"
            SupabaseDB[(PostgreSQL)]
            SupabaseAuth[Auth Service]
            SupabaseStorage[Object Storage]
        end
    end
    
    subgraph "External Services"
        subgraph "AI Services"
            OpenAI[OpenAI API]
            LangChainService[LangChain.js]
        end
        
        subgraph "Third-Party Services"
            MailService[Email Service]
            AnalyticsService[Analytics]
        end
    end
    
    %% Connections
    Browser <-->|HTTPS| NextFrontend
    Browser <-->|API Calls| APIRoutes
    Browser <-->|SSE| EdgeFunctions
    
    NextFrontend --> APIRoutes
    APIRoutes --> EdgeFunctions
    
    APIRoutes <--> SupabaseDB
    APIRoutes <--> SupabaseAuth
    APIRoutes <--> SupabaseStorage
    
    EdgeFunctions <--> OpenAI
    APIRoutes <--> OpenAI
    APIRoutes <--> LangChainService
    LangChainService <--> OpenAI
    
    APIRoutes --> MailService
    NextFrontend --> AnalyticsService
    
    %% Deployment Notes
    classDef vercel fill:#F0F0F0,stroke:#333,stroke-width:2px
    classDef supabase fill:#E6F7FF,stroke:#333,stroke-width:2px
    classDef external fill:#F5F5F5,stroke:#333,stroke-width:2px
    
    class NextFrontend,APIRoutes,EdgeFunctions vercel
    class SupabaseDB,SupabaseAuth,SupabaseStorage supabase
    class OpenAI,LangChainService,MailService,AnalyticsService external
