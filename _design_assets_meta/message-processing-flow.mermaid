sequenceDiagram
    participant User
    participant ChatUI as Chat UI
    participant API as Message API
    participant LangChain as LangChain Service
    participant Context as Context Builder
    participant LLM as Unified LLM
    participant Extractor as Asset Extractor
    participant AssetMgr as Asset Manager
    participant DB as Databases
    
    User->>ChatUI: Sends message
    ChatUI->>API: POST /api/messages
    API->>LangChain: processMessage(text, projectId)
    
    LangChain->>Context: buildContext(projectId, messageHistory)
    Context->>DB: getRecentMessages(conversationId)
    DB-->>Context: Return message history
    Context->>DB: getProjectDetails(projectId)
    DB-->>Context: Return project details
    Context->>DB: queryRelevantAssets(message)
    DB-->>Context: Return relevant assets
    Context-->>LangChain: Return unified context
    
    LangChain->>LLM: generateResponse(context, message)
    LLM-->>LangChain: Return raw response
    
    LangChain->>Extractor: extractAssets(response)
    
    alt Assets Detected
        Extractor->>AssetMgr: storeAsset(content, type, projectId)
        AssetMgr->>DB: saveAsset(content, metadata)
        DB-->>AssetMgr: Return assetId
        AssetMgr-->>Extractor: Return asset reference
        Extractor-->>LangChain: Return processed response + asset refs
    else No Assets
        Extractor-->>LangChain: Return unchanged response
    end
    
    LangChain->>DB: saveMessage(response, conversationId)
    LangChain-->>API: Return processed response
    API-->>ChatUI: Return response with asset references
    
    ChatUI->>User: Display message
    
    alt Assets Present
        ChatUI->>API: GET /api/assets/{assetId}
        API->>AssetMgr: getAsset(assetId)
        AssetMgr->>DB: fetchAsset(assetId)
        DB-->>AssetMgr: Return asset data
        AssetMgr-->>API: Return asset
        API-->>ChatUI: Return asset data
        ChatUI->>User: Render asset in conversation
    end
