flowchart TD
    User((User))
    
    subgraph "Frontend"
        Requirements[Project Requirements Input]
        Chat[Design Assistant Chat]
        Assets[Asset Selection/Viewing]
        Export[Export Interface]
    end
    
    subgraph "Data Processing"
        ReqProcessor[Requirements Processor]
        ChatProcessor[Chat Message Processor]
        ExportProcessor[Export Processor]
    end
    
    subgraph "AI Services"
        LLM[Large Language Model]
        TemplateEngine[Prompt Template Engine]
    end
    
    subgraph "Data Storage"
        ProjectDB[(Project Database)]
        AssetDB[(Design Assets Storage)]
    end
    
    %% User interactions
    User -->|1. Inputs project requirements| Requirements
    User -->|2. Requests design changes| Chat
    User -->|3. Views generated assets| Assets
    User -->|4. Exports assets| Export
    
    %% Frontend to Processing
    Requirements -->|5. Raw requirements| ReqProcessor
    Chat -->|6. Design questions/feedback| ChatProcessor
    Export -->|7. Export requests| ExportProcessor
    
    %% Processing to AI
    ReqProcessor -->|8. Structured requirements| TemplateEngine
    ChatProcessor -->|9. Processed messages| TemplateEngine
    TemplateEngine -->|10. Formatted prompts| LLM
    
    %% AI to Storage
    LLM -->|11a. System design decisions| ProjectDB
    LLM -->|11b. Generated diagrams| AssetDB
    
    %% Storage to Frontend
    ProjectDB -->|12. Project context| ChatProcessor
    AssetDB -->|13. Diagram code| Assets
    
    %% Export paths
    AssetDB -->|14. Asset data| ExportProcessor
    ExportProcessor -->|15. Formatted exports| User
