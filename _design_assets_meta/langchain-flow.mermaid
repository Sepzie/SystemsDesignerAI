flowchart TD
    Start([User Input]) --> Router[Input Router Chain]
    
    Router --> InputClassifier{Input Type?}
    
    InputClassifier -->|New Project| RequirementsChain[Requirements Analysis Chain]
    InputClassifier -->|Design Change| DesignChain[Design Modification Chain]
    InputClassifier -->|Question| QAChain[Project Knowledge QA Chain]
    InputClassifier -->|Export Request| ExportChain[Export Generation Chain]
    
    subgraph "Requirements Analysis Process"
        RequirementsChain --> ExtractEntities[Entity Extraction Chain]
        ExtractEntities --> TechStackAnalysis[Tech Stack Analysis Chain]
        TechStackAnalysis --> InitialDesignPlan[Design Planning Chain]
        InitialDesignPlan --> DiagramGeneration1[Diagram Generation Chain]
    end
    
    subgraph "Design Modification Process"
        DesignChain --> ContextLoading[Context Loading Chain]
        ContextLoading --> ChangeAnalysis[Change Analysis Chain]
        ChangeAnalysis --> DiagramUpdate[Diagram Update Chain]
        DiagramUpdate --> ValidationChain[Validation Chain]
    end
    
    subgraph "Knowledge QA Process"
        QAChain --> RetrievalChain[Project Retrieval Chain]
        RetrievalChain --> SummarizationChain[Context Summarization Chain] 
        SummarizationChain --> AnswerFormulation[Answer Formulation Chain]
    end
    
    subgraph "Export Process"
        ExportChain --> AssetSelection[Asset Selection Chain]
        AssetSelection --> FormatConversion[Format Conversion Chain]
        FormatConversion --> PromptGeneration[Prompt Generation Chain]
    end
    
    %% Memory components
    MemoryDB[(Conversation Memory)] <--> Router
    ProjectDB[(Project Data)] <--> ContextLoading
    ProjectDB <--> RetrievalChain
    
    %% External tools
    DiagramGeneration1 --> MermaidParser[Mermaid Parser Tool]
    DiagramUpdate --> MermaidParser
    ValidationChain --> SyntaxValidator[Syntax Validation Tool]
    
    %% Outputs
    DiagramGeneration1 --> DiagramOutput[Diagram Code Output]
    ValidationChain --> DiagramOutput
    AnswerFormulation --> ResponseOutput[Chat Response Output]
    PromptGeneration --> PromptOutput[Code Prompt Output]
    
    %% Final outputs
    DiagramOutput --> End([Output to User])
    ResponseOutput --> End
    PromptOutput --> End
